# Copy this file to .env for local development. .env is ignored by Git.
# Production hosts use their own environment settings with the same variable names.

# Local server settings. The hosted deployment uses the same variable names
# entered in the host dashboard; this ignored local file is not uploaded.
NODE_ENV="development"
PORT="3000"

# Owner sign-in (server only; never expose with a VITE_ prefix)
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-long-unique-password"
OWNER_NAME="Shop Owner"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Supabase PostgreSQL: copy Connect -> Session pooler for IPv4-compatible hosting.
# The URI uses postgres.[PROJECT-REF] as the username, port 5432, and the exact
# pooler host shown by Supabase. Replace [YOUR-PASSWORD] and URL-encode reserved characters.
# Keep server-only; never add a VITE_ prefix or commit the real password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"
# Supabase requires TLS.
DATABASE_SSL="true"
# Optional node-postgres pool tuning (defaults shown).
DATABASE_CONNECTION_TIMEOUT_MS="10000"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_MAX="3"

# JSON API request limit (image files use a separate 5 MiB raw upload limit).
JSON_BODY_LIMIT="100mb"

# Optional product image storage. Create the bucket first in Supabase Storage.
# Set all three together; the service role key is server-only and must never use a VITE_ prefix.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<server-only-secret>"
# SUPABASE_STORAGE_BUCKET="product-images"
